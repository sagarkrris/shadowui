# Copy this file to .env.local and add your Gemini API key
# Get your FREE key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: point the Live Code Runner to a self-hosted or approved Piston API.
# The old public Piston endpoint became whitelist-only in February 2026.
# PISTON_EXECUTE_URL=https://your-piston-host.example.com/api/v2/execute
