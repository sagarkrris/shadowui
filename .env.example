# Copy this file to .env.local and add your Gemini API key
# Get your FREE key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
SESSION_SECRET=<long_random_secret_1>
APP_ENCRYPTION_KEY=<long_random_secret_2>
# Managed PostgreSQL connection string. Required for account sync in production.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Optional connection pool size for serverless instances.
DB_POOL_MAX=5
# Set to 1 in production to require an account for AI-backed routes.
REQUIRE_AUTH=1

# Shared serverless rate limiting (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Auth email delivery webhook. The provider should send verification/reset links.
# EMAIL_WEBHOOK_URL=https://your-email-service.example/api/send
# EMAIL_WEBHOOK_TOKEN=your_email_service_token
# Resend transactional email delivery (preferred). Verify a domain before using a custom sender.
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=InterviewIQ <onboarding@resend.dev>
# APP_BASE_URL=https://elevateprep.vercel.app

# Public SEO configuration. Set these to your deployed site and the token
# Google Search Console provides when you choose HTML-tag verification.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-provided-token

# Optional monitoring/error webhook and Gemini cost estimates in USD per million tokens.
# ERROR_TRACKING_WEBHOOK_URL=https://your-monitoring.example/api/events
# ERROR_TRACKING_TOKEN=your_monitoring_token
# GEMINI_INPUT_COST_PER_MILLION=0
# GEMINI_OUTPUT_COST_PER_MILLION=0

# Database audit retention. Backups and point-in-time recovery are configured in the managed database provider.
DATA_RETENTION_DAYS=90
METRICS_WEBHOOK_URL=
METRICS_WEBHOOK_TOKEN=

# Optional: point the Live Code Runner to a self-hosted or approved Piston API.
# The old public Piston endpoint became whitelist-only in February 2026.
# PISTON_EXECUTE_URL=https://your-piston-host.example.com/api/v2/execute

# Optional: enable the Live Java Runner through Vercel Sandbox.
# In production on Vercel, Sandbox auth is automatic. For local development,
# run `vercel link` and `vercel env pull`, or set VERCEL_TEAM_ID,
# VERCEL_PROJECT_ID, and VERCEL_TOKEN.
# CODE_RUNNER_PROVIDER=vercel-sandbox
# VERCEL_SANDBOX_JAVA_SNAPSHOT_ID=your-java-enabled-snapshot-id
# Development only: install Java in each new sandbox when no snapshot is set.
# VERCEL_SANDBOX_AUTO_INSTALL_JAVA=1
